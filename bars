#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.bars/venv"
REQUIREMENTS="$SCRIPT_DIR/cli/requirements.txt"

if [ ! -f "$VENV_DIR/bin/python" ]; then
    echo "[bars] Bootstrapping CLI environment..."
    mkdir -p "$SCRIPT_DIR/.bars"
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -q -r "$REQUIREMENTS"
    echo "[bars] Ready."
fi

exec "$VENV_DIR/bin/python" -m cli.main "$@"
