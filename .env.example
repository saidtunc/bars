# Copy to .env and adjust. Do NOT commit your real .env.
APP_NAME=Bars
APP_VERSION=0.1.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

BASE_DIR=/app
STORAGE_PATH=/app/storage
REPORTS_PATH=/app/reports

DATABASE_URL=sqlite+aiosqlite:///./pentest_toolbox.db

MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=3600

WS_HEARTBEAT_INTERVAL=30
WS_REQUIRE_AUTH=true

HOST_AGENT_URL=http://host.docker.internal:8001
# Shared secret between the backend and the host agent. The agent runs arbitrary shell
# commands, so it refuses to start without one. `bars start` generates this automatically.
HOST_AGENT_TOKEN=

# Change these before any shared/networked deployment.
AUTH_REQUIRED=true
AUTH_SECRET_KEY=change-me-to-a-long-random-string

# Multi-node collaboration: set a UNIQUE id per node (e.g. node-alice, node-bob).
SYNC_ENABLED=false
NODE_ID=node-changeme
